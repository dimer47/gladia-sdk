{
  "name": "@dimer47/gladia-sdk",
  "version": "2.1.0",
  "description": "Handcrafted TypeScript SDK for the Gladia API — pre-recorded transcription & real-time live streaming via WebSocket",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dimer47/gladia-sdk"
  },
  "keywords": [
    "gladia",
    "transcription",
    "speech-to-text",
    "websocket",
    "live-streaming",
    "diarization",
    "translation",
    "typescript",
    "sdk"
  ],
  "author": "dimer47",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "write:version": "node scripts/write-version.mjs",
    "check:version": "node scripts/check-version.mjs",
    "build": "npm run write:version && tsup",
    "generate:openapi": "openapi-typescript docs/openapi.json -o src/generated/openapi.ts --default-non-nullable false",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "lint": "eslint src tests scripts --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.md\"",
    "validate": "npm run check:version && npm run check:contracts && npm run lint && npm run format:check && npm run test && npm run typecheck && npm run check:package && npm audit --audit-level=moderate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "GLADIA_E2E=1 vitest run tests/e2e.test.ts --testTimeout=600000",
    "manual:e2e": "npm run build && node scripts/manual-e2e.mjs",
    "prepack": "npm run validate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.8",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
